<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RbacWebApi.AvaloniaClient.ViewModels"
        x:Class="RbacWebApi.AvaloniaClient.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="登录 - RBAC 管理客户端"
        Width="460" Height="420"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="True"
        Design.Width="460" Design.Height="420">
  <Design.DataContext>
    <vm:LoginViewModel/>
  </Design.DataContext>

  <Grid Background="#FFF2F2F2">
    <Border Width="400" Height="340" Background="White"
            CornerRadius="8" BoxShadow="0 4 24 #40000000"
            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
      <StackPanel Spacing="16">
        <TextBlock Text="欢迎登录" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,16"/>

        <TextBox Watermark="用户名" Text="{Binding Username, Mode=TwoWay}" />
        <TextBox Watermark="密码" Text="{Binding Password, Mode=TwoWay}" PasswordChar="*" />

        <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
          <Button Content="登录" Command="{Binding LoginCommand}" Classes="Accent" IsEnabled="{Binding !IsLoading}"/>
          <Button Grid.Column="1" Content="注册" Command="{Binding RegisterCommand}" IsEnabled="{Binding !IsLoading}"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <ProgressBar IsIndeterminate="{Binding IsLoading}" Width="200" Height="4" />
        </StackPanel>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="#FF666666"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
