# ==========================================================
#  .gitignore  for  RbacWebApi  (.NET 10 + Avalonia)
# ==========================================================

# ---------- Visual Studio ----------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.vspscc
*.vssscc
[Dd]ebug/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/
*.dll.config
*.pdb
*.exe.config
*.csproj.user
*.vbproj.user
*.sln.docstates

# ---------- Visual Studio Code ----------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# ---------- JetBrains Rider / IntelliJ ----------
.idea/
*.sln.iml

# ---------- .NET 编译产物 ----------
*.dll
*.exe
*.pdb
*.cache
*.deps.json
*.runtimeconfig.json
*.staticwebassets.endpoints.json
*.staticwebassets.build.json
*.AssemblyInfo.cs
*.GlobalUsings.g.cs
*.GeneratedMSBuildEditorConfig.editorconfig
*.NETCoreApp,Version=v*.AssemblyAttributes.cs
project.assets.json
project.nuget.cache
*.csproj.nuget.dgspec.json
*.csproj.nuget.g.props
*.csproj.nuget.g.targets
*.Up2Date

# ---------- NuGet ----------
*.nupkg
*.snupkg
[Pp]ackages/
*.nuget.props
*.nuget.targets

# ---------- Avalonia ----------
.avalonia-build-tasks/
*.axaml.baml

# ---------- 应用配置（保留 appsettings.json，忽略本地覆盖） ----------
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.Production.json
**/launchSettings.json
**/Properties/launchSettings.json

# ---------- 数据库与运行时数据 ----------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.db3

# ---------- 上传/云盘运行时文件存储 ----------
[RbacWebApi]/files/
**/files/
**/.chunks/

# ---------- 日志 ----------
*.log
*.tmp
Logs/
logs/

# ---------- 操作系统 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.lnk

# ---------- 测试 ----------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult/
coverage/
*.coverage
*.coveragexml

# ---------- 临时文件 ----------
*.swp
*.bak
*.orig
~$*
