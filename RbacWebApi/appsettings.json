{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InitDb": 0,
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=./rbac.db"
  },
  "JwtSettings": {
    "SecretKey": "RbacWebApiSuperSecretKey12345678901234567890",
    "Issuer": "RbacWebApi",
    "Audience": "RbacWebApiClient",
    "ExpiryMinutes": 60
  },
  "FileStorage": {
    "BasePath": "./files",
    "ChunkDir": ".chunks"
  }
}
